# =============================================================================
# SAC — Sistema de Administración Comunitaria
# Ejemplo de variables de entorno. Copiar a `.env.local` y completar valores.
#
#   cp .env.example .env.local
#
# `.env.local` está en .gitignore y NUNCA debe subirse al repositorio.
# =============================================================================

# -----------------------------------------------------------------------------
# Variables PÚBLICAS (seguras para el cliente / navegador)
#
# El prefijo NEXT_PUBLIC_ hace que Next.js exponga estas variables en el bundle
# del navegador. SOLO deben llevar este prefijo valores que puedan ser públicos.
# El navegador usa exclusivamente la clave anónima; todas las lecturas quedan
# sujetas a las políticas RLS de PostgreSQL (Requirements 40.2, 40.3).
# -----------------------------------------------------------------------------

# URL del proyecto Supabase (local: http://localhost:54321).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Clave anónima (anon key). Segura para el cliente: su acceso está limitado por RLS.
# En local, el CLI imprime esta clave con `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Variables PRIVADAS (SOLO servidor — jamás en el cliente)
#
# NO usar el prefijo NEXT_PUBLIC_ aquí. Estas variables solo deben leerse en
# Server Actions / RPC / código de servidor. La `service_role` key omite RLS,
# por lo que exponerla al navegador comprometería todo el aislamiento
# multi-tenant (Requirements 40.3).
#
# Se verifica con pruebas de seguridad que la service_role NUNCA aparezca en
# el bundle del cliente (ver tarea 2.8).
# -----------------------------------------------------------------------------

# Clave de servicio (service_role). Omite RLS. USO EXCLUSIVO EN SERVIDOR.
# En local, el CLI la imprime con `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
